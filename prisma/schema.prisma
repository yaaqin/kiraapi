generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  ADMIN
}

enum Category {
  HAIRCUT
  COLORING
  SMOOTHING
  CREAMBATH
  HAIRSTYLING
  ADDONS
  RETAIL
}

enum PaymentMethod {
  CASH
  TRANSFER
  QRIS
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  name          String
  passwordHash  String
  role          Role           @default(ADMIN)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  transactions  Transaction[]
  expenses      Expense[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model CatalogItem {
  id          Int               @id @default(autoincrement())
  name        String
  category    Category
  price       Int
  duration    String?
  imageUrl    String?
  isAvailable Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  orderItems  TransactionItem[]
}

model Transaction {
  id            Int               @id @default(autoincrement())
  code          String            @unique
  subtotal      Int
  discount      Int
  tax           Int
  total         Int
  voucherCode   String?
  paymentMethod PaymentMethod
  cashReceived  Int?
  cashierId     Int?
  cashier       User?             @relation(fields: [cashierId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  items         TransactionItem[]

  @@index([createdAt])
}

model TransactionItem {
  id            Int          @id @default(autoincrement())
  transactionId Int
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  catalogItemId Int?
  catalogItem   CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  name          String
  price         Int
  qty           Int
}

/// Money leaving one of the cash accounts: manual operating costs and petty cash.
model Expense {
  id          Int           @id @default(autoincrement())
  description String
  amount      Int
  account     PaymentMethod
  isPettyCash Boolean       @default(false)
  pic         String?
  createdById Int?
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([createdAt])
}
